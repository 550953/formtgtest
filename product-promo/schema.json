{
  "form_id": "product-promo-clarify-2026",
  "title": "Уточнение требований: Продвижение товара в соцсетях",
  "intro": "Добрый день! Чтобы правильно оценить объём работы, стоимость и возможные результаты — ответьте, пожалуйста, на вопросы ниже. Это займёт 3–4 минуты.",
  "sections": [
    {
      "title": "Товар и цель",
      "icon": "🎯",
      "fields": [
        {
          "id": "product_type",
          "type": "radio",
          "label": "Что именно нужно продвигать?",
          "required": true,
          "options": [
            "Физический товар (одежда, техника, товары для дома и т.д.)",
            "Услуга",
            "Инфопродукт / курс",
            "Бренд / аккаунт в целом",
            "Другое"
          ]
        },
        {
          "id": "product_description",
          "type": "textarea",
          "label": "Кратко опишите товар/услугу и её особенности",
          "required": true,
          "placeholder": "Например: дублёнка женская, размер 46-48, цена 12 000 ₽, состояние отличное..."
        },
        {
          "id": "main_goal",
          "type": "checkbox",
          "label": "Какая главная цель продвижения?",
          "required": true,
          "options": [
            "Привлечь подписчиков в аккаунт",
            "Получить заявки / сообщения от клиентов",
            "Прямые продажи (оплата)",
            "Увеличить охваты и узнаваемость",
            "Прогреть аудиторию под будущие продажи"
          ]
        },
        {
          "id": "success_metric",
          "type": "textarea",
          "label": "Какой результат вы считаете успешным?",
          "required": true,
          "placeholder": "Например: +500 живых подписчиков за месяц / 30 заявок / 10 продаж"
        }
      ]
    },
    {
      "title": "Площадки и текущее состояние",
      "icon": "📱",
      "fields": [
        {
          "id": "platforms",
          "type": "checkbox",
          "label": "В каких соцсетях нужно продвигать?",
          "required": true,
          "options": [
            "ВКонтакте",
            "Telegram",
            "Instagram*",
            "MAX",
            "YouTube",
            "TikTok / Likee",
            "Другое"
          ]
        },
        {
          "id": "current_accounts",
          "type": "textarea",
          "label": "Есть ли уже аккаунты? Пришлите ссылки",
          "required": false,
          "placeholder": "Ссылки на существующие страницы / каналы"
        },
        {
          "id": "current_subscribers",
          "type": "text",
          "label": "Сколько сейчас подписчиков / какая активность?",
          "required": false,
          "placeholder": "Например: 1200 подписчиков, 5-10 лайков на пост"
        },
        {
          "id": "content_ready",
          "type": "radio",
          "label": "Есть ли готовый контент (фото, видео, описания)?",
          "required": true,
          "options": [
            "Да, контент полностью готов",
            "Есть часть материалов",
            "Контент нужно создавать с нуля",
            "Нужна помощь с фото/видеосъёмкой"
          ]
        }
      ]
    },
    {
      "title": "Бюджет и модель работы",
      "icon": "💰",
      "fields": [
        {
          "id": "ad_budget_source",
          "type": "radio",
          "label": "Кто оплачивает рекламный бюджет (таргет, посевы, блогеры)?",
          "required": true,
          "options": [
            "Бюджет оплачиваю я (заказчик) отдельно",
            "Исполнитель вкладывает свои деньги, потом компенсируем",
            "Всё включено в стоимость услуги исполнителя",
            "Пока не определились — нужно обсудить"
          ]
        },
        {
          "id": "monthly_budget",
          "type": "radio",
          "label": "Какой примерный рекламный бюджет в месяц готовы выделить?",
          "required": true,
          "options": [
            "До 10 000 ₽",
            "10–30 000 ₽",
            "30–70 000 ₽",
            "70–150 000 ₽",
            "Более 150 000 ₽",
            "Бюджет пока не определён"
          ]
        },
        {
          "id": "payment_model",
          "type": "radio",
          "label": "Какая модель оплаты работы исполнителя предпочтительна?",
          "required": true,
          "options": [
            "Фиксированная стоимость за период (месяц / пакет)",
            "Оплата за результат (за подписчика / заявку / продажу)",
            "Смешанная (фикс + бонус за результат)",
            "Обсудим после уточнения задач"
          ]
        }
      ]
    },
    {
      "title": "Ограничения и пожелания",
      "icon": "⚠️",
      "fields": [
        {
          "id": "audience_quality",
          "type": "radio",
          "label": "Какое качество аудитории критично важно?",
          "required": true,
          "options": [
            "Только живые и целевые люди",
            "Допустима небольшая доля неактивных",
            "Главное — цифры, качество вторично",
            "Нужно обсудить"
          ]
        },
        {
          "id": "forbidden_methods",
          "type": "checkbox",
          "label": "Какие методы точно нельзя использовать?",
          "required": false,
          "options": [
            "Накрутка ботами",
            "Массовый спам в личные сообщения",
            "Покупка подписчиков",
            "Серые схемы и накрутки",
            "Нет жёстких ограничений"
          ]
        },
        {
          "id": "geo",
          "type": "text",
          "label": "Какая география аудитории нужна?",
          "required": false,
          "placeholder": "Например: Россия, Москва и МО, вся РФ, СНГ..."
        },
        {
          "id": "deadline",
          "type": "radio",
          "label": "Когда нужны первые результаты?",
          "required": true,
          "options": [
            "В течение 7–10 дней",
            "В течение месяца",
            "2–3 месяца",
            "Без жёстких сроков"
          ]
        }
      ]
    },
    {
      "title": "Дополнительно",
      "icon": "📝",
      "fields": [
        {
          "id": "additional_info",
          "type": "textarea",
          "label": "Есть ли ещё важная информация, ограничения или пожелания?",
          "required": false,
          "placeholder": "Любые детали, которые помогут лучше понять задачу"
        },
        {
          "id": "contact_info",
          "type": "text",
          "label": "Как к вам обращаться и удобный контакт (Telegram / телефон):",
          "required": true,
          "placeholder": "Имя, @username или номер"
        }
      ]
    }
  ]
}
