{
  "form_id": "tarot-ai-clarify-2026",
  "title": "Уточнения по проекту «Таро ИИ»",
  "intro": "Привет! Чтобы сразу заложить правильную архитектуру и не переделывать потом — ответь на несколько вопросов. Займёт 5–7 минут.",
  "sections": [
    {
      "title": "Общее",
      "icon": "🔮",
      "fields": [
        { "id": "has_brand", "type": "radio", "label": "Есть ли уже название/бренд/логотип приложения?", "required": true,
          "options": ["Да, всё готово", "Есть название, дизайна нет", "Ничего нет, нужно предложить"] },
        { "id": "platform", "type": "checkbox", "label": "На каких платформах должно работать?", "required": true,
          "options": ["Веб (браузер)", "Мобильное приложение (iOS/Android)", "Telegram Mini App", "Пока не решено"] },
        { "id": "languages", "type": "checkbox", "label": "Какие языки интерфейса нужны?", "required": true,
          "options": ["Русский", "Английский", "Другой (укажи)"] },
        { "id": "reference_apps", "type": "textarea", "label": "Есть ли референсы — похожие приложения/сайты, которые нравятся по виду или логике?", "required": false,
          "placeholder": "Ссылки или названия" }
      ]
    },
    {
      "title": "ИИ и трактовки",
      "icon": "🤖",
      "fields": [
        { "id": "ai_provider", "type": "radio", "label": "Какой ИИ использовать для трактовок?", "required": true,
