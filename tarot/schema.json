        { "id": "starter_decks", "type": "number", "label": "Сколько тематических колод нужно на старте (помимо стандартной)?", "required": true,
          "placeholder": "Число" },
        { "id": "spread_type", "type": "checkbox", "label": "Какие расклады нужны, кроме расклада на 3 карты?", "required": false,
          "options": ["Только 3 карты пока", "Кельтский крест", "На отношения", "На день/неделю", "Другое (укажи)"] }
      ]
    },
    {
      "title": "Аккаунты и монетизация",
      "icon": "💳",
      "fields": [
        { "id": "auth_method", "type": "checkbox", "label": "Каким способом пользователи будут регистрироваться?", "required": true,
