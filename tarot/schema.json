        { "id": "free_reading", "type": "text", "label": "Что именно даёт «первый бесплатный расклад»?", "required": true,
          "placeholder": "Например: 1 расклад на 3 карты по стандартной колоде" },
        { "id": "payment_provider", "type": "radio", "label": "Через что принимать оплату за звёзды?", "required": true,
          "options": ["ЮKassa/российский эквайринг", "Зарубежный эквайринг (Stripe и т.п.)", "Криптовалюта", "Пока не знаю, посоветуй"] },
        { "id": "pricing_model", "type": "textarea", "label": "Есть ли уже представление о ценах (сколько стоит звезда, сколько звёзд на расклад/колоду)?", "required": false,
          "placeholder": "Если нет — оставь пустым, предложу модель" }
      ]
    },
    {
      "title": "Консультация с тарологом",
      "icon": "🧙",
      "fields": [
        { "id": "has_tarologists", "type": "radio", "label": "Есть ли уже реальные тарологи, готовые консультировать?", "required": true,
          "options": ["Да, есть команда/человек", "Пока нет, нужно продумать", "Это будет позже, не первая версия"] },
        { "id": "booking_method", "type": "radio", "label": "Как организовать запись на консультацию?", "required": false,
          "options": ["Встроенный календарь в приложении", "Через Telegram-бота вручную", "Внешний сервис бронирования", "Не знаю, предложи"] }
      ]
    },
    {
      "title": "Технологии и сроки",
      "icon": "🛠",
      "fields": [
        { "id": "has_hosting", "type": "radio", "label": "Есть ли уже сервер/хостинг под проект?", "required": true,
          "options": ["Да, есть VPS/облако", "Нет, нужно подобрать", "Хочу минимизировать расходы (serverless)"] },
        { "id": "has_domain_tarot", "type": "radio", "label": "Есть домен под приложение?", "required": true,
          "options": ["Да", "Нет, нужно подобрать/купить"] },
        { "id": "deadline_tarot", "type": "radio", "label": "Когда нужен рабочий прототип (MVP)?", "required": true,
          "options": ["Без жёстких сроков", "В течение месяца", "2–4 недели", "Точная дата — укажу в комментарии"] },
        { "id": "budget_range", "type": "text", "label": "Есть ли ориентир по бюджету на разработку?", "required": false,
          "placeholder": "Можно диапазон, можно пропустить" }
      ]
    },
    {
      "title": "Финал",
      "icon": "✨",
      "fields": [
        { "id": "extra_notes_tarot", "type": "textarea", "label": "Есть ли ещё что-то важное, о чём я должен знать?", "required": false,
          "placeholder": "Твой комментарий..." },
        { "id": "contact_name", "type": "text", "label": "Как к тебе обращаться?", "required": false,
          "placeholder": "Имя" },
        { "id": "reference_files", "type": "file", "label": "Можешь прикрепить референсы/макеты/примеры карт, если есть", "required": false,
          "note": "Загружается в Backblaze B2, ссылка на файл будет действовать 7 дней" }
      ]
    }
  ]
