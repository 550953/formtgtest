        { "id": "interpretation_style", "type": "radio", "label": "Какой стиль трактовок нужен?", "required": true,
          "options": ["Мистический/атмосферный", "Простой и практичный, без эзотерики", "Психологический (архетипы, самоанализ)", "Смешанный — решай сам"] },
        { "id": "context_memory", "type": "radio", "label": "Насколько глубоко ИИ должен учитывать историю прошлых раскладов?", "required": true,
          "options": ["Только последний расклад", "Несколько последних", "Всю историю пользователя целиком"] }
      ]
    },
    {
      "title": "Карты и колоды",
      "icon": "🃏",
      "fields": [
        { "id": "deck_art", "type": "radio", "label": "Откуда брать изображения карт?", "required": true,
